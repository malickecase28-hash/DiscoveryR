{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstrumentScope",
  "type": "object",
  "required": [
    "instrument",
    "interval"
  ],
  "properties": {
    "instrument": {
      "$ref": "#/definitions/Instrument"
    },
    "interval": {
      "$ref": "#/definitions/ScopeInterval"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Instrument": {
      "type": "object",
      "required": [
        "dataset_identity",
        "instrument_id",
        "venue"
      ],
      "properties": {
        "dataset_identity": {
          "type": "string"
        },
        "instrument_id": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ScopeInterval": {
      "type": "object",
      "required": [
        "dataset_identity",
        "end_time_ns",
        "instrument_id",
        "scope_id",
        "start_time_ns"
      ],
      "properties": {
        "dataset_identity": {
          "type": "string"
        },
        "end_time_ns": {
          "type": "integer",
          "format": "int64"
        },
        "instrument_id": {
          "type": "string"
        },
        "scope_id": {
          "type": "string"
        },
        "start_time_ns": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false
    }
  }
}
