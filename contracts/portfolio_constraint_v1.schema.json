{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PortfolioConstraint",
  "type": "object",
  "required": [
    "confirmed_strategy_ids",
    "constraint_id",
    "kind",
    "parameters"
  ],
  "properties": {
    "confirmed_strategy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraint_id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/PortfolioConstraintKind"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "PortfolioConstraintKind": {
      "type": "string",
      "enum": [
        "CORRELATION",
        "OVERLAP",
        "CAPITAL_ALLOCATION",
        "DRAWDOWN",
        "CAPACITY",
        "TURNOVER",
        "LIQUIDITY",
        "CONCENTRATION",
        "RISK_BUDGET",
        "STRESS"
      ]
    }
  }
}
