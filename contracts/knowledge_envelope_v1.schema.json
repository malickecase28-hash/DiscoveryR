{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeEnvelope",
  "type": "object",
  "required": [
    "envelope_version",
    "facets",
    "knowledge_id",
    "record"
  ],
  "properties": {
    "envelope_version": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "facets": {
      "$ref": "#/definitions/KnowledgeFacets"
    },
    "knowledge_id": {
      "type": "string"
    },
    "record": {
      "$ref": "#/definitions/KnowledgeRecord"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "BarScale": {
      "type": "string",
      "enum": [
        "15s",
        "30s",
        "1m",
        "5m",
        "15m",
        "1h",
        "4h"
      ]
    },
    "ChallengeDecision": {
      "type": "string",
      "enum": [
        "OPEN",
        "SURVIVED",
        "FAILED",
        "INCONCLUSIVE"
      ]
    },
    "FindingStatus": {
      "type": "string",
      "enum": [
        "DISCOVERY",
        "CANDIDATE",
        "CONFIRMED",
        "REJECTED",
        "NULL",
        "INCONCLUSIVE"
      ]
    },
    "KnowledgeFacets": {
      "type": "object",
      "required": [
        "anchor_ids",
        "context_ids",
        "detector_ids",
        "evidence_ids",
        "instrument_ids",
        "lifecycle_states",
        "native_scales",
        "portfolio_ids",
        "strategy_ids"
      ],
      "properties": {
        "anchor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detector_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instrument_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle_states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native_scales": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NativeScale"
          },
          "uniqueItems": true
        },
        "portfolio_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strategy_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "KnowledgeRecord": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "content",
            "created_utc",
            "provenance",
            "record_id",
            "record_type",
            "status"
          ],
          "properties": {
            "content": true,
            "created_utc": {
              "type": "string"
            },
            "provenance": {
              "$ref": "#/definitions/Provenance"
            },
            "record_id": {
              "type": "string"
            },
            "record_type": {
              "type": "string",
              "enum": [
                "QUESTION"
              ]
            },
            "status": {
              "$ref": "#/definitions/QuestionStatus"
            },
            "superseded_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "supersedes": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "content",
            "created_utc",
            "provenance",
            "record_id",
            "record_type",
            "status"
          ],
          "properties": {
            "content": true,
            "created_utc": {
              "type": "string"
            },
            "provenance": {
              "$ref": "#/definitions/Provenance"
            },
            "record_id": {
              "type": "string"
            },
            "record_type": {
              "type": "string",
              "enum": [
                "FINDING"
              ]
            },
            "rejection_reason": {
              "anyOf": [
                {
                  "$ref": "#/definitions/RejectionReason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "$ref": "#/definitions/FindingStatus"
            },
            "superseded_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "supersedes": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "content",
            "created_utc",
            "decision",
            "provenance",
            "record_id",
            "record_type"
          ],
          "properties": {
            "content": true,
            "created_utc": {
              "type": "string"
            },
            "decision": {
              "$ref": "#/definitions/ChallengeDecision"
            },
            "provenance": {
              "$ref": "#/definitions/Provenance"
            },
            "record_id": {
              "type": "string"
            },
            "record_type": {
              "type": "string",
              "enum": [
                "CHALLENGE"
              ]
            },
            "superseded_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "supersedes": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "content",
            "created_utc",
            "provenance",
            "record_id",
            "record_type"
          ],
          "properties": {
            "content": true,
            "created_utc": {
              "type": "string"
            },
            "provenance": {
              "$ref": "#/definitions/Provenance"
            },
            "record_id": {
              "type": "string"
            },
            "record_type": {
              "type": "string",
              "enum": [
                "KNOWLEDGE"
              ]
            },
            "superseded_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "supersedes": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "NativeScale": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Tick"
          ]
        },
        {
          "type": "object",
          "required": [
            "Bar"
          ],
          "properties": {
            "Bar": {
              "$ref": "#/definitions/BarScale"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Provenance": {
      "type": "object",
      "required": [
        "evidence_ids"
      ],
      "properties": {
        "code_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "experiment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "researcher_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "QuestionStatus": {
      "type": "string",
      "enum": [
        "OPEN"
      ]
    },
    "RejectionReason": {
      "type": "string",
      "enum": [
        "METHOD_FAILURE",
        "CONFIRMATION_FAILURE"
      ]
    }
  }
}
