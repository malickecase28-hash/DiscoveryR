      "type": "string"
    },
    "holdout_policy_identity": {
      "type": "string"
    },
    "metric_identity": {
      "type": "string"
    },
    "multiplicity_family_identity": {
      "type": "string"
    },
    "null_design_identity": {
      "type": "string"
    },
    "outcome_identity": {
      "type": "string"
    },
    "population_identity": {
